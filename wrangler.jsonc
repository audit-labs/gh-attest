{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gh-attest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Storage is pinned to the EU jurisdiction so evidence stays in the EEA.
  // Jurisdiction is immutable: moving it means recreating these resources
  // and migrating the data. Create them as in the README's Deployment section.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gh-attest-db-eu",
      // From `wrangler d1 create gh-attest-db-eu --jurisdiction eu`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "r2_buckets": [
    { "binding": "EXPORTS", "bucket_name": "gh-attest-exports-eu", "jurisdiction": "eu" }
  ],

  "queues": {
    "producers": [
      { "binding": "GENERATE_EXPORT", "queue": "generate-export" }
    ],
    "consumers": [
      { "queue": "generate-export", "max_batch_size": 10, "max_batch_timeout": 30 }
    ]
  }
}
